# Sparky — fully-local configuration. No cloud API keys at runtime.
# Copy to .env and point the URLs at wherever the inference stack runs
# (see deploy/README.md). Defaults assume everything on this machine.

# --- speech (Spark A services) ---
RIVA_SERVER=localhost:50051
RIVA_MODEL=
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart

# --- NAT agent server (runs next to the bot) ---
NAT_BASE_URL=http://localhost:8001/v1

# --- LLM endpoints used by the NAT config (per model profile) ---
AGENT_LLM_BASE_URL=http://localhost:8010/v1
AGENT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
CHITCHAT_LLM_BASE_URL=http://localhost:8010/v1
CHITCHAT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
ROUTER_LLM_BASE_URL=http://localhost:8030/v1
ROUTER_LLM_MODEL=microsoft/Phi-3-mini-128k-instruct
VISION_LLM_BASE_URL=http://localhost:8020/v1
VISION_LLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8

# --- offline wikipedia tool ---
WIKI_BASE_URL=http://localhost:8040

# --- robot control API (bot process; used by NAT agent tools) ---
ROBOT_API_BASE_URL=http://localhost:7861
#ROBOT_API_HOST=127.0.0.1
#ROBOT_API_PORT=7861

# --- robot ---
REACHY_USE_SIM=true
# Allow discovering a daemon over the network (robot attached to another host)
REACHY_LOCALHOST_ONLY=false
REACHY_WAKE_ON_START=true
#REACHY_TIMEOUT=15.0
#REACHY_RETRY_ATTEMPTS=3

# --- robot audio (mic + speaker on the Reachy; devices default to the
# PipeWire echo-cancelled nodes set up by deploy/setup-robot-audio.sh) ---
#AUDIO_IN_DEVICE=
#AUDIO_OUT_DEVICE=
# aec = PipeWire echo cancellation (barge-in works); gate = mute mic while speaking
ECHO_MODE=aec
#ROBOT_CAMERA_INDEX=0
