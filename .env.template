# Sparky — fully-local configuration. No cloud API keys at runtime.
# Copy to .env and point the URLs at the two Sparks (see deploy/README.md):
# magi = speech + router, shodan = agent/vision LLM + wiki. When the bot
# runs ON magi use deploy/profiles/magi.bot.env instead; roaming clients
# are configured by app/launcher.py from remote-client.bot.env.

# --- speech (magi services) ---
RIVA_SERVER=localhost:50051
RIVA_MODEL=
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart

# --- NAT agent server (runs next to the bot) ---
NAT_BASE_URL=http://localhost:8001/v1

# --- LLM endpoints used by the NAT config ---
AGENT_LLM_BASE_URL=http://localhost:8010/v1
AGENT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
CHITCHAT_LLM_BASE_URL=http://localhost:8010/v1
CHITCHAT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
ROUTER_LLM_BASE_URL=http://localhost:8010/v1
ROUTER_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
VISION_LLM_BASE_URL=http://localhost:8010/v1
VISION_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4

# --- offline wikipedia tool ---
WIKI_BASE_URL=http://localhost:8040

# --- robot control API (bot process; used by NAT agent tools) ---
ROBOT_API_BASE_URL=http://localhost:7861
#ROBOT_API_HOST=127.0.0.1
#ROBOT_API_PORT=7861

# --- robot ---
REACHY_USE_SIM=true
# Allow discovering a daemon over the network (robot attached to another host)
REACHY_LOCALHOST_ONLY=false
REACHY_WAKE_ON_START=true
#REACHY_TIMEOUT=15.0
#REACHY_RETRY_ATTEMPTS=3

# --- robot audio (see deploy/setup-robot-audio.sh) ---
# Mic captured directly from hardware (PipeWire capture of this device is
# unstable); output through PipeWire for volume control.
AUDIO_IN_DEVICE=Reachy Mini
AUDIO_OUT_DEVICE=pipewire
# gate = mic silenced while the robot speaks (no voice barge-in; the
# validated mode — no AEC path exists)
ECHO_MODE=gate
#ROBOT_CAMERA_INDEX=0
#VAD_STOP_SECS=0.6

# --- optional tools (toggle in panel > Tools; state persists in ~/.sparky/tools.json) ---
# seed only: the panel toggle overrides and persists
#WEB_SEARCH_ENABLED=1
