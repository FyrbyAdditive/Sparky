# Spark-side secrets/overrides for the Sparky stack (copy to deploy/stack/.env
# on each Spark; merged with the host profile as
#   cat .env ../profiles/<host>.env > envfile-merged).

# --- one-time setup credentials (runtime is offline) ---
NGC_API_KEY=nvapi-FIXME
HF_TOKEN=

# --- images (defaults shown) ---
#VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3     # shodan uses vllm-node:latest via shodan.env
#KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest

# --- model/memory knobs live in the host profiles ---
# shodan.env: AGENT_MODEL (Qwen3.6-35B NVFP4), AGENT_GPU_FRACTION=0.50,
#             AGENT_MAX_MODEL_LEN=49152, AGENT_EXTRA_ARGS (MTP etc.), WIKI_INDEX
# magi.env:   ROUTER_MODEL (phi-3), ROUTER_GPU_FRACTION=0.14, ROUTER_MAX_MODEL_LEN

# --- HF cache location: set to an absolute path (e.g. /home/tim/.cache/huggingface)
# to reuse the host cache as a bind mount; leave unset for a named docker volume ---
#HF_CACHE_DIR=/home/tim/.cache/huggingface
