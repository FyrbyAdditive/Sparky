# Spark-side settings for the Sparky inference stack (copy to deploy/spark-a/.env)

# --- one-time setup credentials (runtime is offline) ---
NGC_API_KEY=nvapi-FIXME
HF_TOKEN=

# --- images ---
#VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3
#KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:latest

# --- models (parity profile defaults; see deploy/profiles/ for alternatives) ---
#AGENT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
#VISION_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
#ROUTER_MODEL=microsoft/Phi-3-mini-128k-instruct
#WIKI_INDEX=neuml/txtai-wikipedia

# --- memory tuning (fractions of 128GB unified memory; keep sum of the three <= 0.70) ---
#AGENT_GPU_FRACTION=0.40
#VISION_GPU_FRACTION=0.20
#ROUTER_GPU_FRACTION=0.08

# --- context lengths ---
#AGENT_MAX_MODEL_LEN=32768
#VISION_MAX_MODEL_LEN=16384
#ROUTER_MAX_MODEL_LEN=8192

# --- extra vLLM args (e.g. speculative decoding config for MTP models) ---
#AGENT_EXTRA_ARGS=
#VISION_EXTRA_ARGS=
#ROUTER_EXTRA_ARGS=
