# Profile: duo-2spark, magi half (robot/audio host).
# magi: cd deploy/stack && docker compose --env-file ../profiles/duo-2spark-magi.env up -d
# The phi-3 router also lives here (co-located with NAT = fastest routing hop)
# but sits in the "llm" compose profile, so bring it up by service name:
#   docker compose --env-file ../profiles/duo-2spark-magi.env up -d vllm-router
COMPOSE_PROFILES=audio

ROUTER_MODEL=microsoft/Phi-3-mini-128k-instruct
# 0.08 starves the KV cache on GB10 ("No available memory for cache blocks")
ROUTER_GPU_FRACTION=0.14
ROUTER_MAX_MODEL_LEN=8192
