# Profile: duo-2spark — audio on magi (robot host), inference on shodan,
# traffic over the ConnectX-7 interconnect (192.168.100.0/24).
#
# shodan: cd deploy/stack && docker compose --env-file ../profiles/duo-2spark.env up -d --build
# magi:   COMPOSE_PROFILES=audio (see duo-2spark-magi.env) — or keep the
#         existing running audio containers.

COMPOSE_PROFILES=wiki
# agent brought up by service name (router intentionally not on this host)

# Inference host budget: everything must fit SIMULTANEOUSLY (boot restarts
# all containers at once, ignoring depends_on). Measured: the agent engine
# carries ~30GB of host-side overhead (CUDA graphs, MTP draft, multimodal)
# on TOP of its GPU fraction. agent 0.50 (~60GB + ~30GB overhead) + wiki
# 16GB cap = ~106GB of 121GB. The phi-3 router lives on the ROBOT host
# instead (tiny, co-located with NAT = fastest routing hop).
AGENT_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
AGENT_GPU_FRACTION=0.50
AGENT_MAX_MODEL_LEN=49152
VLLM_IMAGE=vllm-node:latest
VLLM_MARLIN_USE_ATOMIC_ADD=1
AGENT_EXTRA_ARGS=--kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --max-num-seqs 4 --max-num-batched-tokens 8192 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --load-format fastsafetensors --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}' --default-chat-template-kwargs '{"enable_thinking":false}'

# (router knobs live in duo-2spark-magi.env — the phi-3 router runs on magi)

# Full Wikipedia index — the inference host has the RAM to cache it.
WIKI_INDEX=neuml/txtai-wikipedia
