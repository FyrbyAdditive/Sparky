# Bot-host env when the robot lives on magi (inference on shodan over the
# ConnectX-7 interconnect). Copy to the repo root as .env for systemd runs.
SPARK_B_IB=192.168.100.2

# audio stays local to the robot host
RIVA_SERVER=localhost:50051
RIVA_MODEL=
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart

NAT_BASE_URL=http://localhost:8001/v1

# inference over the interconnect
AGENT_LLM_BASE_URL=http://${SPARK_B_IB}:8010/v1
AGENT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
CHITCHAT_LLM_BASE_URL=http://${SPARK_B_IB}:8010/v1
CHITCHAT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
ROUTER_LLM_BASE_URL=http://localhost:8030/v1
ROUTER_LLM_MODEL=microsoft/Phi-3-mini-128k-instruct
VISION_LLM_BASE_URL=http://${SPARK_B_IB}:8010/v1
VISION_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4

WIKI_BASE_URL=http://${SPARK_B_IB}:8040
ROBOT_API_BASE_URL=http://localhost:7861

# robot + audio (the validated magi configuration)
REACHY_USE_SIM=false
REACHY_LOCALHOST_ONLY=false
AUDIO_IN_DEVICE=Reachy Mini
AUDIO_OUT_DEVICE=pipewire
ECHO_MODE=gate
