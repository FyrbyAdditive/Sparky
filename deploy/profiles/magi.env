# magi — the audio host and the robot's home: nemotron-asr (STT +
# streaming sortformer diarization), kokoro-tts, phi-3 router (co-located
# with NAT = fastest routing hop), tls-proxy for the panel.
#
# Bring-up: cd deploy/stack && cat .env ../profiles/magi.env > envfile-merged \
#           && docker compose --env-file envfile-merged up -d
COMPOSE_PROFILES=magi

ROUTER_MODEL=microsoft/Phi-3-mini-128k-instruct
# 0.08 starves the KV cache on GB10 ("No available memory for cache blocks")
ROUTER_GPU_FRACTION=0.14
ROUTER_MAX_MODEL_LEN=8192
