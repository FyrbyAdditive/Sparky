# Bot-host env for profile parity-1spark.
# Usage: set SPARK_A_HOST, then `cp` this over .env at the repo root (or merge).
SPARK_A_HOST=localhost

RIVA_SERVER=${SPARK_A_HOST}:50051
KOKORO_BASE_URL=http://${SPARK_A_HOST}:8880/v1
KOKORO_VOICE=af_heart

NAT_BASE_URL=http://localhost:8001/v1

AGENT_LLM_BASE_URL=http://${SPARK_A_HOST}:8010/v1
AGENT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
CHITCHAT_LLM_BASE_URL=http://${SPARK_A_HOST}:8010/v1
CHITCHAT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
ROUTER_LLM_BASE_URL=http://${SPARK_A_HOST}:8030/v1
ROUTER_LLM_MODEL=microsoft/Phi-3-mini-128k-instruct
VISION_LLM_BASE_URL=http://${SPARK_A_HOST}:8020/v1
VISION_LLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8

WIKI_BASE_URL=http://${SPARK_A_HOST}:8040
ROBOT_API_BASE_URL=http://localhost:7861

# Set false on the host with the real robot attached (sim needs a --sim daemon)
REACHY_USE_SIM=true
REACHY_LOCALHOST_ONLY=false
