# Profile: parity-1spark (default)
# Same models the upstream demo used via NVIDIA cloud, served locally on one Spark.
# Spark A: docker compose --env-file ../profiles/parity-1spark.env up -d --build

COMPOSE_PROFILES=parity

AGENT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
AGENT_GPU_FRACTION=0.40
AGENT_MAX_MODEL_LEN=32768

VISION_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
VISION_GPU_FRACTION=0.20
VISION_MAX_MODEL_LEN=16384

ROUTER_MODEL=microsoft/Phi-3-mini-128k-instruct
ROUTER_GPU_FRACTION=0.08
ROUTER_MAX_MODEL_LEN=8192

# Set these before bring-up (or in deploy/spark-a/.env alongside this file)
#NGC_API_KEY=
#HF_TOKEN=
