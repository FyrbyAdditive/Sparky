# Bot-host env for profile quality-2spark-split: agent LLM on Spark A,
# everything else on Spark B.
SPARK_A_HOST=spark-a.local
SPARK_B_HOST=spark-b.local

RIVA_SERVER=${SPARK_B_HOST}:50051
KOKORO_BASE_URL=http://${SPARK_B_HOST}:8880/v1
KOKORO_VOICE=af_heart

NAT_BASE_URL=http://localhost:8001/v1

AGENT_LLM_BASE_URL=http://${SPARK_A_HOST}:8010/v1
AGENT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
CHITCHAT_LLM_BASE_URL=http://${SPARK_A_HOST}:8010/v1
CHITCHAT_LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
ROUTER_LLM_BASE_URL=http://${SPARK_B_HOST}:8030/v1
ROUTER_LLM_MODEL=microsoft/Phi-3-mini-128k-instruct
VISION_LLM_BASE_URL=http://${SPARK_B_HOST}:8020/v1
VISION_LLM_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8

WIKI_BASE_URL=http://${SPARK_B_HOST}:8040
ROBOT_API_BASE_URL=http://localhost:7861

REACHY_USE_SIM=true
REACHY_LOCALHOST_ONLY=false
