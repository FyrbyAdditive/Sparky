# Profile: quality-2spark-split
# Spark A: Nemotron-3-Super-120B-A12B NVFP4 (85GB, built-in MTP, ~23 tok/s) —
#   the quality pick that still decodes faster than speech.
# Spark B: vision + router + STT + TTS + wiki (deploy/spark-b compose).
#
# Spark A: cd deploy/spark-a && docker compose --env-file ../profiles/quality-2spark-split.env up -d
# Spark B: cd deploy/spark-b && docker compose --env-file ../profiles/quality-2spark-split.env up -d --build

COMPOSE_PROFILES=split

AGENT_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
AGENT_GPU_FRACTION=0.80
AGENT_MAX_MODEL_LEN=32768
# Nemotron Super has built-in MTP heads; enable per the model card / vLLM
# build on your Spark:
#AGENT_EXTRA_ARGS=--speculative-config {"method":"mtp","num_speculative_tokens":3}

# Spark B services (defaults match parity)
VISION_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
VISION_GPU_FRACTION=0.30
ROUTER_MODEL=microsoft/Phi-3-mini-128k-instruct
ROUTER_GPU_FRACTION=0.10

#NGC_API_KEY=
#HF_TOKEN=
