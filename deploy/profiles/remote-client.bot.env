# Remote-client template: robot plugged into a Mac/Linux machine, all
# inference on the Sparks over LAN. The launcher substitutes the hosts
# and writes the result to ~/.sparky/remote.env — edit that file to tune.

# speech services (Spark audio host)
RIVA_SERVER=@AUDIO_HOST@:50051
RIVA_MODEL=
KOKORO_BASE_URL=http://@AUDIO_HOST@:8880/v1
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart

# NAT runs locally next to the bot (keeps robot tools working)
NAT_BASE_URL=http://localhost:8001/v1

# inference (Spark LLM host)
AGENT_LLM_BASE_URL=http://@LLM_HOST@:8010/v1
AGENT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
CHITCHAT_LLM_BASE_URL=http://@LLM_HOST@:8010/v1
CHITCHAT_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
ROUTER_LLM_BASE_URL=http://@LLM_HOST@:8010/v1
ROUTER_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
VISION_LLM_BASE_URL=http://@LLM_HOST@:8010/v1
VISION_LLM_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4

WIKI_BASE_URL=http://@LLM_HOST@:8040
ROBOT_API_BASE_URL=http://localhost:7861

# robot + audio: capture and playback both on the robot's own hardware.
# (No pipewire off the Spark — match the device by name on CoreAudio/ALSA.)
REACHY_USE_SIM=false
REACHY_LOCALHOST_ONLY=false
AUDIO_IN_DEVICE="Reachy Mini"
AUDIO_OUT_DEVICE="Reachy Mini"
ECHO_MODE=gate
#PREROLL_MS=300
#VAD_STOP_SECS=0.6

# --- optional tools (toggle in panel > Tools; state persists in ~/.sparky/tools.json) ---
# seed only: the panel toggle overrides and persists
#WEB_SEARCH_ENABLED=1
# self-hosted metasearch backing the web_search tool
SEARXNG_URL=http://@AUDIO_HOST@:8888
