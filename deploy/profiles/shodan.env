# shodan — the inference host: vllm-agent (Qwen3.6-35B multimodal, serves
# agent/chitchat/vision) + wiki-offline (full index). Traffic arrives over
# the ConnectX-7 interconnect (192.168.100.2).
#
# Bring-up: cd deploy/stack && cat .env ../profiles/shodan.env > envfile-merged \
#           && docker compose --env-file envfile-merged up -d --build

COMPOSE_PROFILES=shodan

# Inference host budget: everything must fit SIMULTANEOUSLY (boot restarts
# all containers at once, ignoring depends_on). Measured: the agent engine
# carries ~30GB of host-side overhead (CUDA graphs, MTP draft, multimodal)
# on TOP of its GPU fraction. agent 0.50 (~60GB + ~30GB overhead) + wiki
# 16GB cap = ~106GB of 121GB. The phi-3 router lives on the ROBOT host
# instead (tiny, co-located with NAT = fastest routing hop).
AGENT_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
# 0.38 = ~46GB pool: ~20GB NVFP4 weights + ~25GB KV — plenty for a single
# user at 48k ctx with prefix caching. 0.50 held ~40GB of KV nobody used
# while the host sat 2.6GB into swap. vLLM fails fast at boot if the pool
# is ever too small ("No available memory for the cache blocks").
AGENT_GPU_FRACTION=0.38
AGENT_MAX_MODEL_LEN=49152
VLLM_IMAGE=vllm-node:latest
VLLM_MARLIN_USE_ATOMIC_ADD=1
# seqs 3 (1 live turn + 1 speculative stream + margin) and batched-tokens
# 4096 (single-user; chunked prefill splits bigger prompts) shrink the
# scheduler/graph workspace — shodan was 2.6GB into swap at seqs 4/8192.
AGENT_EXTRA_ARGS=--kv-cache-dtype fp8 --attention-backend flashinfer --moe-backend marlin --max-num-seqs 3 --max-num-batched-tokens 4096 --enable-chunked-prefill --async-scheduling --enable-prefix-caching --load-format fastsafetensors --reasoning-parser qwen3 --speculative-config '{"method":"mtp","num_speculative_tokens":3,"moe_backend":"triton"}' --default-chat-template-kwargs '{"enable_thinking":false}'

# (router knobs live in magi.env — the phi-3 router runs on magi)

# Full Wikipedia index — the inference host has the RAM to cache it.
WIKI_INDEX=neuml/txtai-wikipedia
