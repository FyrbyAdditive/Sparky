# Profile: unified-1spark
# One modern multimodal MoE (Qwen3.6-35B-A3B, NVFP4, MTP speculative decoding)
# serves agent + chitchat + vision + routing. ~18GB weights, ~100-268 tok/s
# reported on Spark with MTP. Apache-2.0.
# Spark A: docker compose --env-file ../profiles/unified-1spark.env up -d --build

COMPOSE_PROFILES=unified

AGENT_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
AGENT_GPU_FRACTION=0.55
AGENT_MAX_MODEL_LEN=32768
# MTP speculative decoding. Exact flags depend on the vLLM build shipped in
# VLLM_IMAGE — check `vllm serve --help` / the model card on your Spark and
# adjust. Known-good recipes: NVIDIA forum "Qwen3.6-35B-A3B NVFP4 on DGX Spark".
#AGENT_EXTRA_ARGS=--speculative-config {"method":"mtp","num_speculative_tokens":3}

# No mamba cache flag needed for Qwen3.6; leave the default in the compose
# command harmless (vLLM ignores it for non-hybrid models) or override:
#AGENT_EXTRA_ARGS=

#NGC_API_KEY=
#HF_TOKEN=
