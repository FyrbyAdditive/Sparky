# Profile: unified-1spark
# One modern multimodal MoE (Qwen3.6-35B-A3B, NVFP4, MTP speculative decoding)
# serves agent + chitchat + vision + routing. ~18GB weights, ~100-268 tok/s
# reported on Spark with MTP. Apache-2.0.
# Spark A: docker compose --env-file ../profiles/unified-1spark.env up -d --build

COMPOSE_PROFILES=unified

AGENT_MODEL=RedHatAI/Qwen3.6-35B-A3B-NVFP4
AGENT_GPU_FRACTION=0.50
AGENT_MAX_MODEL_LEN=32768
# MTP speculative decoding + thinking off (voice latency). If the engine
# rejects the speculative config, check `vllm serve --help` in the container —
# method naming varies by build (mtp / qwen3_next_mtp).
AGENT_EXTRA_ARGS=--speculative-config '{"method":"mtp","num_speculative_tokens":3}' --default-chat-template-kwargs '{"enable_thinking":false}'

#NGC_API_KEY=
#HF_TOKEN=
