[Unit]
Description=Sparky voice bot (pipecat)
After=network.target reachy-daemon.service
Wants=reachy-daemon.service

[Service]
WorkingDirectory=%h/Sparky/bot
ExecStart=%h/.local/bin/uv run --env-file %h/Sparky/.env python main.py --host 0.0.0.0 --port 7860
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
